{
  "$schema": "node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.10.0",
    "generators": {
      "v1": {
        "generatorName": "typescript-axios",
        "inputSpec": "openapi.yaml",
        "output": ".",
        "additionalProperties": { "npmName": "@griffnode/js-sdk", "npmVersion": "1.0.1", "supportsES6": "true", "useSingleRequestParameter": "true", "gitUserId": "GriffNode", "gitRepoId": "js-sdk" }
      }
    }
  }
}
